# ---- required ---------------------------------------------------------------
SAWII_ADMIN_TOKEN=change-me-to-a-long-random-string     # creates personas (openssl rand -hex 32)
SAWII_FEATHERLESS_API_KEY=                              # default provider for A, B, C, embeddings
# For another OpenAI-compatible provider, set these; per-lobe endpoint/key values override them.
# SAWII_PROVIDER_BASE_URL=https://api.provider.example/v1
# SAWII_PROVIDER_API_KEY=
SAWII_PUBLIC_BASE_URL=https://your-domain.example       # used to verify Twilio webhooks

# ---- the three lobes (any OpenAI-compatible endpoint) -----------------------
# Existing Featherless model defaults; its API key is only sent to Featherless.
SAWII_A_MODEL=Qwen/Qwen3.8-Flash-Next
SAWII_B_MODEL=openai/gpt-oss-120b
SAWII_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# If OPENROUTER_API_KEY is set and no C-specific/shared provider endpoint is set,
# C automatically uses OpenRouter's free-model router. Per-lobe values override this.
# SAWII_C_BASE_URL=https://openrouter.ai/api/v1
# SAWII_C_MODEL=openrouter/free
# A - the voice. For a fine-tuned voice point it at Fireworks:
#   SAWII_A_BASE_URL=https://api.fireworks.ai/inference/v1  SAWII_A_API_KEY=fw_...  SAWII_A_MODEL=accounts/<you>/models/<base>
SAWII_EMBED_ENABLED=false                               # local hash fallback; avoids unsupported remote embeddings
# For provider free tiers, configure a shared compatible endpoint/key and account-enabled model IDs.
SAWII_FREE_MODE=true
SAWII_FREE_REQUEST_INTERVAL_SECONDS=2.1
SAWII_FREE_REQUESTS_PER_MINUTE=10
SAWII_FREE_MAX_CONCURRENT_REQUESTS=3
# SAWII_FREE_TOKENS_PER_MINUTE=8000  # set to your provider/model limit; 0 disables this cap
# SAWII_FREE_REQUESTS_PER_DAY=1000   # set to your provider/model limit; 0 disables this cap
SAWII_FREE_RETRY_ATTEMPTS=2
SAWII_FREE_MAX_RETRY_WAIT_SECONDS=30
SAWII_FREE_MODE_CONSULTANTS=false
# SAWII_CONSULT_MODELS=deepseek-ai/DeepSeek-V3.1,Qwen/Qwen3-235B-A22B   # parallel minds (optional)
# SAWII_CONSULT_WAIT_MS=300
# SAWII_A_TOOLS=true
# SAWII_SHOW_VERDICT=false                              # show B's verdict to the user too

# ---- memory / feeling tuning -------------------------------------------------
# SAWII_RECALL_BAND=0.30   SAWII_UNADDRESSED_DAYS=3   SAWII_LIVE_CHECKS_MAX=3
# SAWII_PSYCHE_HALF_LIFE_DAYS=21

# ---- initiative ---------------------------------------------------------------
# SAWII_HEARTBEAT_SECONDS=60  SAWII_REFLECT_EVERY_TICKS=30  SAWII_QUIET_HOURS=22:30-08:00
# SAWII_DAILY_OUTREACH_CAP=4  SAWII_OUTREACH_GAP_MIN=90

# ---- sleep / fine-tune -----------------------------------------------------------
# SAWII_SLEEP_HOUR=3   SAWII_JUICE_FLOOR=0.55   SAWII_BUFFER_ROWS=2000   SAWII_BOWL_RATIO=0.9
# SAWII_FINETUNE_PROVIDER=fireworks          # none | fireworks | command
# SAWII_FIREWORKS_API_KEY=   SAWII_FIREWORKS_ACCOUNT=   SAWII_FIREWORKS_BASE_MODEL=accounts/fireworks/models/qwen3-8b
# SAWII_FINETUNE_MIN_EXAMPLES=40   SAWII_REPLAY_RATIO=0.2
# SAWII_FINETUNE_COMMAND="python my_trainer.py"   # gets the JSONL path as last arg; exit 0 = baked

# ---- voice (optional: without these the browser does speech recognition + speech) ---
# SAWII_ASR_BASE_URL=https://api.openai.com/v1  SAWII_ASR_API_KEY=  SAWII_ASR_MODEL=whisper-1
# SAWII_TTS_BASE_URL=https://api.openai.com/v1  SAWII_TTS_API_KEY=  SAWII_TTS_MODEL=tts-1  SAWII_TTS_VOICE=alloy

# ---- channels (each optional) ------------------------------------------------------
# SAWII_TWILIO_ACCOUNT_SID=  SAWII_TWILIO_AUTH_TOKEN=  SAWII_TWILIO_FROM=+1...  SAWII_TWILIO_WHATSAPP_FROM=whatsapp:+1...
#   webhook: POST {PUBLIC_BASE_URL}/hooks/twilio   (SMS and WhatsApp)
# SAWII_TELEGRAM_BOT_TOKEN=  SAWII_TELEGRAM_WEBHOOK_SECRET=   webhook: /hooks/telegram
# SAWII_SMTP_HOST=  SAWII_SMTP_PORT=587  SAWII_SMTP_USER=  SAWII_SMTP_PASSWORD=  SAWII_SMTP_FROM=
# SAWII_EMAIL_INBOUND_SECRET=   inbound email JSON {"from","text"} -> /hooks/email?secret=...
